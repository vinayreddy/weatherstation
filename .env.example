# Camera
WS_RTSP_STREAM=rtsp://user:pass@192.168.1.x:554/stream

# Weather Underground (get key at wunderground.com/member/api-keys)
WS_WU_API_KEY=
WS_WU_STATION_ID=KWASEATT3003

# Storage
WS_IMAGE_DIR=./data/images
WS_DB_PATH=./data/weather.db

# Server
WS_HTTP_PORT=8080
WS_REFRESH_SECS=30

# Alerting via Mailtrap (optional; falls back to log-only alerter)
WS_MAILTRAP_API_TOKEN=
WS_ALERT_EMAIL_TO=
WS_ALERT_EMAIL_FROM=weatherstation@localhost

# Image lifecycle (storage management)
# Hard cap on the image directory size (human-readable: 5GB, 500MB, ...). <=0 disables.
WS_IMAGE_DISK_LIMIT=5GB
# Keep this many days of images locally; older days are archived+deleted.
WS_IMAGE_RETENTION_DAYS=90
# rsync/ssh destination for archived images (user@host:/path). Empty = delete without archiving.
WS_IMAGE_ARCHIVE_DEST=
# How often (hours) to run the retention/archival sweep (720 = monthly).
WS_IMAGE_ARCHIVE_EVERY_HOURS=720
