# Camera
WS_RTSP_STREAM=rtsp://user:pass@192.168.1.x:554/stream

# Weather Underground (get key at wunderground.com/member/api-keys)
WS_WU_API_KEY=
WS_WU_STATION_ID=KWASEATT3003

# Storage
WS_IMAGE_DIR=./data/images
WS_DB_PATH=./data/weather.db

# Server
# Plain-HTTP port. When WS_TLS_ENABLE=true this also serves ACME HTTP-01 challenges
# and 302-redirects everything to HTTPS. Router maps external:80 -> Pi:WS_HTTP_PORT.
WS_HTTP_PORT=8080
WS_REFRESH_SECS=30
# Max concurrent in-flight HTTP requests; beyond this the server replies 503
# instead of queuing unbounded work (a request flood can't exhaust goroutines).
# <=0 disables the cap.
WS_MAX_INFLIGHT_REQUESTS=64

# HTTPS via Let's Encrypt (autocert). When false, serves plain HTTP on WS_HTTP_PORT.
WS_TLS_ENABLE=false
# Public FQDN the certificate is issued for (REQUIRED when WS_TLS_ENABLE=true).
WS_DOMAIN=weather.example.com
# In-process HTTPS listen port. Router maps external:443 -> Pi:WS_TLS_PORT.
WS_TLS_PORT=8443
# Where autocert caches the ACME account key + issued certs. Must persist across
# restarts AND be writable by the service user (see systemd StateDirectory).
WS_CERT_DIR=/var/lib/weatherstation/certs
# Optional Let's Encrypt account email (recommended — receives expiry warnings).
WS_ACME_EMAIL=

# Alerting via Mailtrap (optional; falls back to log-only alerter)
WS_MAILTRAP_API_TOKEN=
WS_ALERT_EMAIL_TO=
WS_ALERT_EMAIL_FROM=weatherstation@localhost

# Image lifecycle (storage management)
# Hard cap on the image directory size (human-readable: 5GB, 500MB, ...). <=0 disables.
WS_IMAGE_DISK_LIMIT=5GB
# Keep this many days of images locally; older days are archived+deleted.
WS_IMAGE_RETENTION_DAYS=90
# rsync/ssh destination for archived images (user@host:/path). Empty = delete without archiving.
WS_IMAGE_ARCHIVE_DEST=
# How often (hours) to run the retention/archival sweep (720 = monthly).
WS_IMAGE_ARCHIVE_EVERY_HOURS=720

# Highlights & aurora detection
# Camera location, used for sun position (golden hour / day-night gating) and to
# judge whether the sky is dark enough for aurora. Defaults to Seattle, Capitol Hill.
WS_LATITUDE=47.62
WS_LONGITUDE=-122.32
# Minimum NOAA planetary Kp index (0-9) to flag a frame as a possible aurora.
# Seattle (~47.6°N) realistically needs ~6+. Kp data comes free from NOAA SWPC.
WS_AURORA_KP_THRESHOLD=6
# Number of top-scoring "best shot" frames kept on local disk indefinitely (exempt
# from thinning/archival eviction). Bounds the disk used by pinned highlights.
WS_HIGHLIGHT_PIN_COUNT=300
